# ---------------------------------------------------------------------------
# LLM provider configuration
# ---------------------------------------------------------------------------
# Which provider to use: anthropic | openai | heuristic
#   anthropic  -> Claude models (recommended)
#   openai     -> OpenAI or any OpenAI-compatible endpoint
#   heuristic  -> no API calls; deterministic local analyzer (offline demo mode)
LLM_PROVIDER=anthropic

# Model id for the selected provider.
# Anthropic examples: claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001
# OpenAI examples:    gpt-4o, gpt-4o-mini
LLM_MODEL=claude-sonnet-5

# API keys — never hardcode these in source.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: custom base URL (self-hosted / proxy / Azure-style gateways)
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Throughput / reliability
# ---------------------------------------------------------------------------
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=5
LLM_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=50

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
CACHE_DIR=.cache
